  },
  "H05-W8": {
   "alt": {
    "LF": 0.047619
   },
   "note": "human LBS / 21 lb/ft"
  },
  "H32-WALK": {
   "alt": {
    "SF": 81.0
   },
   "note": "human CY x 27 / (4\"/12) = SF"
  },
  "R284": {
   "alt": {
    "SF": 1.0
   },
   "note": "the human's '3\" Batt Insulation' row is wall area (198.22 LF x 10'-8\" = 2,117) though marked LF"
  }
 },
